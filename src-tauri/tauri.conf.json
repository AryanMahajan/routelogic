{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RouteLogic",
  "version": "0.4.0",
  "identifier": "dev.routelogic.app",
  "build": {
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "npm run dev"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "npm run build"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RouteLogic",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Codebase-aware API client",
    "longDescription": "Local-first API client that discovers HTTP endpoints from your source code and lets you test them."
  }
}
